# Required only to regenerate AI-generated assets (images, hero video, 3D models)
# via `node build.js` / `node generate3d.js`. The website itself does not need
# this at runtime — all generated assets are already committed to /assets.
WAVESPEED_API_KEY=

# Required for the /book funnel (api/book.js) to save leads to Airtable.
# Set these in the Vercel project's Environment Variables — see README/setup
# notes for the exact Airtable base schema.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Bookings
